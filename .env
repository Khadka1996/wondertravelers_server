# Geolocation
GEOIP_ENABLED=true
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Monitoring
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_MEMORY_MONITORING=true
MEMORY_THRESHOLD_MB=1200

# Development Debugging
DEBUG=express:*,wondertravelers:*
DEBUG_DATABASE=false
DEBUG_REDIS=false
DEBUG_AUDIT=true
SKIP_DEVICE_TRUST_LOCAL=true
SHOW_RESET_TOKEN_IN_DEV=true
MOCK_2FA_IN_DEV=true

# API Configuration
API_BASE_PATH=/api
API_VERSION=v1
API_DOCS_ENABLED=true
API_DOCS_PATH=/api-docs

